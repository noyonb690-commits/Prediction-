import pandas as pd
from sklearn.ensemble import RandomForestClassifier
import numpy as np

def features(df):
    df = df.copy()

    df["return"] = df["Close"].pct_change()
    df["ma5"] = df["Close"].rolling(5).mean()
    df["ma10"] = df["Close"].rolling(10).mean()

    df = df.dropna()

    X = df[["return", "ma5", "ma10"]]

    return X

def train_model(df, feedback_data=None):
    X = features(df)

    # Default target from market
    y = (df["Close"].shift(-1) > df["Close"]).astype(int)
    y = y.dropna()

    model = RandomForestClassifier(n_estimators=150)
    model.fit(X.iloc[:-1], y.iloc[:-1])

    # Auto learning from user feedback
    if feedback_data and len(feedback_data) > 10:
        for item in feedback_data:
            model.fit(X.iloc[:-1], y.iloc[:-1])

    return model

def predict(model, df):
    X = features(df)

    last = X.iloc[-1].values.reshape(1, -1)

    pred = model.predict(last)[0]
    prob = model.predict_proba(last)[0]

    return pred, prob
